# Database and Cache Connections:
DATABASE_URL=
REDIS_URL=
CELERY_BROKER_URL=

# LLM Provider Factory Settings
LLM_PROVIDER=
LLM_MODEL_NAME=
LLM_BASE_URL=
LLM_API_KEY=


# Data Providers Switches
FLIGHT_PROVIDER=stub  # Options: stub, duffel
HOTEL_PROVIDER=stub   # Options: stub, duffel
ACTIVITY_PROVIDER=stub  # Options: stub, foursquare
RESTAURANT_PROVIDER=stub  # Options: stub, foursquare
WEATHER_PROVIDER=stub  # Options: stub, openweathermap
SAFETY_PROVIDER=stub  # Options: stub
MAPS_PROVIDER=stub    # Options: stub, google

# Third-Party Credentials (only used if the switch above is set to something other than 'stub')
DUFFEL_API_KEY=
FOURSQUARE_API_KEY=
OPENWEATHERMAP_API_KEY=
GOOGLE_MAPS_API_KEY=


# Authentication
JWT_SECRET=some-secure-random-string-here


# Application Configuration
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# LangSmith Tracing Configuration
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agents-travel-guide